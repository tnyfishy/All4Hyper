    <!-- Charging -->
    <string name="card_night">Night charge protection</string>
    <string name="t_night_entry">Block the overnight hold (entry)</string>
    <string name="t_night_entry_s">Stops night charge protection from starting, so charging is no longer held at 80%.</string>
    <string name="t_night_state">Block the overnight hold (state)</string>
    <string name="t_night_state_s">Refuses the low-level night charging state, as a second layer.</string>
    <string name="card_limit">Charge limit</string>
    <string name="t_kill_all">Block every protection strategy</string>
    <string name="t_kill_all_s">Night, navigation, always, handle, high temperature and long charge, all at once.</string>
    <string name="t_kill_common">Block common protection</string>
    <string name="t_kill_common_s">High temperature, navigation and long charge limits stop applying.</string>
    <string name="t_override_limit">Override the limit</string>
    <string name="t_override_limit_s">Rewrites the limit Security Center sets. 100% means no limit.</string>
