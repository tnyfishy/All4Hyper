    <!-- System -->
    <string name="card_power">Power and performance</string>
    <string name="t_power_mode">Block power mode switching</string>
    <string name="t_power_mode_s">Performance, power saving and super saving modes stop changing.</string>
    <string name="t_super_save">Block super power saving</string>
    <string name="t_super_save_s">Keeps apps, background and notifications out of the strict saving state.</string>
    <string name="t_fps">No throttling when saving power</string>
    <string name="t_fps_s">Keeps the refresh rate, brightness and screen timeout as they are.</string>
    <string name="t_thermal">No thermal throttling</string>
    <string name="t_thermal_s">Security Center stops sending thermal limits. Watch the temperature.</string>
    <string name="card_perm">Permissions and background</string>
    <string name="t_appops">Lift private AppOps restrictions</string>
    <string name="t_appops_s">Install, chain launch, device ID, screen recording, accessibility and AI screen control can no longer be restricted.</string>
    <string name="t_kill_bg">Keep background apps on clean-up</string>
    <string name="t_kill_bg_s">One-tap clean-up no longer kills background processes.</string>
    <string name="t_autostart">Force allow auto-start</string>
    <string name="t_autostart_s">Apps cannot be denied auto-start from Security Center.</string>
    <string name="card_net">Network and install</string>
    <string name="t_net">Lift per-app network blocking</string>
    <string name="t_net_s">Wi-Fi and mobile data rules are changed to Allow.</string>
    <string name="t_bg_net">Lift background network restriction</string>
    <string name="t_bg_net_s">Apps keep their connection in the background.</string>
    <string name="t_traffic">Keep data on after the limit</string>
    <string name="t_traffic_s">No automatic cut-off when the data plan limit is reached.</string>
    <string name="t_tether">Lift hotspot traffic limit</string>
    <string name="t_tether_s">Hotspot sharing is not stopped at its traffic limit.</string>
    <string name="t_install">Skip install verification</string>
    <string name="t_install_s">Security Center no longer aborts installs at its own verification step.</string>

