    <!-- Google -->
    <string name="nav_google">Google</string>
    <string name="card_companion">Companion module</string>
    <string name="companion_summary">Makes the Google app a system app, tells the system that Circle to Search and its live translate are supported, and sets the power key and navigation handle to Google on every boot. It is installed with root and needs a reboot.</string>
