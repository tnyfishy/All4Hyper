    <string name="fast_title">Fast charge</string>
    <string name="fast_summary">Forcing it on cannot help hardware that does not support it.</string>
    <string name="fast_stock">Stock</string>
    <string name="fast_on">Force on</string>
    <string name="fast_off">Force off</string>
    <string name="bypass_title">Bypass charging</string>
