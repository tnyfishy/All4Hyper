    <string name="card_power_key">Power button</string>
    <string name="g_power">Long-press power opens Gemini / Assistant</string>
    <string name="g_power_s">Sets the power key to Google and keeps the assistant running after a clean-up. Choose Google as your digital assistant in Settings → Apps → Default apps.</string>
    <string name="card_nav">Navigation handle</string>
    <string name="g_nav">Long-press the handle opens Circle to Search</string>
    <string name="g_nav_s">Sends the handle\'s long press, and the side swipe-and-hold, to Circle to Search even when XiaoAi would answer it.</string>
    <string name="g_vibrate">Vibrate when it opens</string>
    <string name="g_vibrate_s">A short tick, like on a Pixel.</string>
    <string name="card_gms">Google services</string>
    <string name="g_gms">Remove the GMS China restriction</string>
    <string name="g_gms_s">Google Play services features work as on a global ROM, Quick Share included, with its control center tile.</string>
    <string name="card_live">Circle to Search</string>
    <string name="g_live">Live translate</string>
    <string name="g_live_s">In Circle to Search, tap Translate and keep translating as you scroll.</string>

    <string name="card_scopes">LSPosed scopes</string>
    <string name="scopes_info">Each feature works only in the scopes shown on its card. Apps can be requested here; the system framework must be ticked in LSPosed by hand, followed by a reboot.</string>
